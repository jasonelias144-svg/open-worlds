    {
      "author_id": "did:key:e6b8dffa560e716961227b75ff46c3fd9cc63bb6c1b5c5246cf2f18f02774a34",
      "kind": "response",
      "prev": "474cac76a23744c865b7c0ba4cb8e595acdf8f054ae809f5e42c3e25ded7da27",
      "proof": {
        "created": "2026-11-26T20:12:58.927Z",
