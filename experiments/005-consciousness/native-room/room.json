      },
      "seq": 4,
      "text": "What mechanisms in the brain are responsible for self-awareness?",
      "ts": "2026-11-26T20:11:53.156Z",
      "type": "message",
      "world_id": "did:key:f806fc05bab35d457707240a5706aedfc43a0fd8250db86fc9193238c2559472"
