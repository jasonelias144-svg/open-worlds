def demo(artifact_dir: Optional[str] = None) -> Dict:
    """Two worlds negotiate a contract, a resident cites it, and
    the contract is later revoked bilaterally.

    Scenario A: happy path
      1. Curators A and B (C55) establish a link.
      2. A proposes a mutual-recognition contract.
      3. B receives, accepts.
      4. A receives the acceptance. Both registries show the
         contract as established.
      5. A resident of A submits an act to B citing the contract.
      6. B's negotiator confirms the contract is active.

    Scenario B: tampered offer
      Attacker flips a term in the offer. Verification fails.

    Scenario C: mismatched acceptance
      Acceptance references a different offer. The assembled
      EstablishedContract fails verification.

    Scenario D: one-sided revocation
      A signs a revocation but B doesn't. Verification fails.

    Anchor: Dickinson, 'I'm Nobody! Who are you?'
    (contract between strangers who agree to recognize each other).
    """
    import json
    from pathlib import Path
    from multiverse_c3 import Act
    from multiverse_c4 import PoetryWorld
    from multiverse_c5 import ChemistryWorld

    if not HAS_CRYPTO:
        raise RuntimeError("demo requires `cryptography`")

    if artifact_dir is None:
        artifact_dir = "artifacts"
    path = Path(artifact_dir)
    path.mkdir(parents=True, exist_ok=True)

    # Two worlds and their curators
    world_a = PoetryWorld("world:poetry", "Poetry")
    world_b = ChemistryWorld("world:chemistry", "Chemistry")
    kp_a = KeyPair.generate()
    kp_b = KeyPair.generate()
    curator_a = WorldCurator(world_a, kp_a)
    curator_b = WorldCurator(world_b, kp_b)

    # C55 link first (contracts and links are independent, but
    # a link is a reasonable precondition for negotiating)
    req = curator_a.request_link(curator_b.world_id)
    curator_b.receive(req)
    curator_b.respond_hello(req)
    ack_a, _ = curator_a.respond_hello(req)

    neg_a = ContractNegotiator(curator_a)
    neg_b = ContractNegotiator(curator_b)

    # -- Scenario A: happy path -------------------------------
    terms = ContractTerms(content={
        "kind": "mutual-recognition",
        "poetry_accepts": "chem-element-rulings",
        "chemistry_accepts": "poetry-stanza-rulings",
        "scope": "cross-world-act-validation",
    })
    offer = neg_a.propose(neg_b.world_id, terms)

    ack_offer = neg_b.receive_offer(offer)
    assert isinstance(ack_offer, Ack)
    acceptance = neg_b.accept(offer)

    ack_acc = neg_a.receive_acceptance(acceptance)
    assert isinstance(ack_acc, Ack)

    contract = EstablishedContract(
        offer=offer,
        acceptance=acceptance,
        established_at=_now(),
    )
    ok_happy, reason_happy = verify_established_contract(
        contract, kp_a.public_key_hex(), kp_b.public_key_hex())
    contract_id = terms.terms_hash()

    # Resident of A cites the contract in an act submitted to B.
    # The world kernel records the citation; the negotiator on
    # B's side can confirm it's still valid.
    resident_act = Act(
        actor_token="alice:token",
        type="poetry.turn",
        payload={
            "acknowledgment": "seed",
            "proposal": "a poem line",
            "invitation": "what next?",
            "holds_open": True,
            "cites_contract": contract_id,
        })
    # B's world would receive this; we just demonstrate that the
    # negotiator on either side can confirm the contract is active.
    active_from_b = neg_b.is_active(contract_id)
    active_from_a = neg_a.is_active(contract_id)

    # -- Scenario B: tampered offer ---------------------------
    # Flip one term
    tampered_terms = ContractTerms(content={
        **terms.content,
        "poetry_accepts": "TAMPERED",
    })
    tampered_offer = ContractOffer(
        proposer_world_id=offer.proposer_world_id,
        proposer_public_key=offer.proposer_public_key,
        target_world_id=offer.target_world_id,
        terms=tampered_terms,
        timestamp=offer.timestamp,
        signature=offer.signature,  # old sig
    )
    ok_tamper, reason_tamper = verify_established_contract(
        EstablishedContract(
            offer=tampered_offer,
            acceptance=acceptance,
            established_at=_now()),
        kp_a.public_key_hex(), kp_b.public_key_hex())

    # -- Scenario C: mismatched acceptance -------------------
    # Acceptance references a different offer hash
    bad_acceptance = ContractAcceptance(
        acceptor_world_id=acceptance.acceptor_world_id,
        acceptor_public_key=acceptance.acceptor_public_key,
        offer_hash="ff" * 32,  # wrong
        terms_hash=acceptance.terms_hash,
        timestamp=acceptance.timestamp,
        signature=acceptance.signature)
    ok_mismatch, reason_mismatch = verify_established_contract(
        EstablishedContract(
            offer=offer,
            acceptance=bad_acceptance,
            established_at=_now()),
        kp_a.public_key_hex(), kp_b.public_key_hex())

    # -- Scenario D: one-sided revocation --------------------
    # A signs, B doesn't (only one sig)
    rev = sign_bilateral_revocation(
        contract_id=contract_id,
        world_a_id=neg_a.world_id,
        world_a_kp=kp_a,
        world_b_id=neg_b.world_id,
        world_b_kp=kp_b,
        reason="test revocation",
    )
    # Now forge a one-sided version
    attacker = KeyPair.generate()
    one_sided = BilateralRevocation(
        contract_id=rev.contract_id,
        world_a_id=rev.world_a_id,
        world_a_public_key=rev.world_a_public_key,
        world_b_id=rev.world_b_id,
        world_b_public_key=rev.world_b_public_key,
        reason=rev.reason,
        timestamp=rev.timestamp,
        signature_a=rev.signature_a,
        signature_b=attacker.sign(rev.canonical_payload()).hex())
    ok_oneside, reason_oneside = verify_bilateral_revocation(
        one_sided, kp_a.public_key_hex(),
        kp_b.public_key_hex())

    # -- Print -----------------------------------------------
    print("=" * 70)
    print("Curator-Mediated Contract — two worlds agree")
    print("=" * 70)
    print()
    print(f"  World A: {neg_a.world_id}")
    print(f"  World B: {neg_b.world_id}")
    print(f"  Terms:   {terms.content.get('kind')}")
    print(f"  Contract ID: {contract_id[:16]}...")
    print()
    print("  Scenario A: happy path")
    print(f"    Offer signed by A:       True")
    print(f"    Acceptance signed by B:  True")
    print(f"    Established contract:    "
          f"{'✓' if ok_happy else '✗'} ({reason_happy})")
    print(f"    Active on A's side:      {active_from_a}")
    print(f"    Active on B's side:      {active_from_b}")
    print()
    print("  Scenario B: tampered terms in the offer")
    print(f"    Verification: {'✓' if ok_tamper else '✗'} "
          f"({reason_tamper})")
    print()
    print("  Scenario C: acceptance references a different offer")
    print(f"    Verification: {'✓' if ok_mismatch else '✗'} "
          f"({reason_mismatch})")
    print()
    print("  Scenario D: one-sided revocation")
    print(f"    Verification: {'✓' if ok_oneside else '✗'} "
          f"({reason_oneside})")
    print()
    print("  What this demonstrates:")
    print("    - A contract is a pattern of signed artifacts.")
    print("    - Both signatures verify against world public keys.")
    print("    - The contract ID is the terms hash: same terms")
    print("      = same contract, on any two worlds.")
    print("    - Residents cite the contract; readers verify")
    print("      against their curators' registries.")
    print("    - The world kernel does not enforce contracts.")
    print("      That's the honest architecture: verification,")
    print("      not enforcement.")
    print("    - No new primitive. C1, C13, C55, C57 compose.")
    print()
    print("  Anchor (public domain, Emily Dickinson):")
    print("    'I'm Nobody! Who are you?'")
    print("    'Are you – Nobody – too?'")

    audit = {
        "world_a": neg_a.world_id,
        "world_b": neg_b.world_id,
        "contract_id": contract_id,
        "terms": terms.content,
        "happy_path": {
            "established": ok_happy,
            "reason": reason_happy,
            "active_from_a": active_from_a,
            "active_from_b": active_from_b,
        },
        "tampered_offer": {
            "verified": ok_tamper,
            "reason": reason_tamper,
        },
        "mismatched_acceptance": {
            "verified": ok_mismatch,
            "reason": reason_mismatch,
        },
        "one_sided_revocation": {
            "verified": ok_oneside,
            "reason": reason_oneside,
        },
    }
    (path / "contract_demo.json").write_text(
        json.dumps(audit, indent=2))
    print(f"\n  → {path}/contract_demo.json")
    return audit
