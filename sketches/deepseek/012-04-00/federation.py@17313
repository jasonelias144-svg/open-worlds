def run_fixture(artifact_dir: Path, signed: bool = True) -> int:
    """Run the collaboration with recorded real HF outputs.

    Proves the pipeline handles real HF formats, no HF install
    required.
    """
    print("=" * 70)
    print("FEDERATION FIXTURE (recorded HF outputs, no model load)")
    print("=" * 70)
    if signed and not HAS_CRYPTO:
        print("⚠ cryptography not installed — falling back to unsigned")
        signed = False
    t0 = time.time()
    report = run_recorded_fixture(seed=42, max_iterations=20,
                                   signed=signed)
    elapsed = time.time() - t0
    print()
    print(report.report())
    (artifact_dir / "collaboration.json").write_text(
        json.dumps(report.to_dict(), indent=2))
    (artifact_dir / "collaboration.txt").write_text(report.report())
    print(f"\n→ {artifact_dir}/collaboration.json")
    print(f"→ {artifact_dir}/collaboration.txt")
    print(f"\nWall-clock: {elapsed*1000:.0f} ms")
    return 0


def run_hf(artifact_dir: Path) -> int:
    """Run with real Hugging Face models.

    Requires transformers + torch. Pre-flight reports what will load
    before the run begins.
    """
    print("=" * 70)
    print("FEDERATION HF (real models, local inference)")
    print("=" * 70)
    try:
        report = run_hf_collaboration(
            seed=42, max_iterations=10, signed=True, preflight=True,
        )
    except RuntimeError as e:
        print(f"\nERROR: {e}")
        return 1
    print(report.report())
    (artifact_dir / "collaboration.json").write_text(
        json.dumps(report.to_dict(), indent=2))
    (artifact_dir / "collaboration.txt").write_text(report.report())
    print(f"\n→ {artifact_dir}/collaboration.json")
    print(f"→ {artifact_dir}/collaboration.txt")
    return 0


