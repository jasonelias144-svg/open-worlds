#[test]
fn garden_reference_keeper_whispers() {
    let v = load_vector();
    // ... build the garden and run the scenario (as before) ...

    let whispers: Vec<&crate::garden::Entry> = garden.log.iter()
        .filter(|e| {
            e.body.get("kind").and_then(|v| v.as_str())
                == Some("keeper_whisper")
        })
        .collect();

    let expected_hashes = v.expected
        .keeper_whisper_body_hashes.as_ref()
        .expect("missing keeper_whisper_body_hashes");

    assert_eq!(whispers.len(), expected_hashes.len(),
        "keeper_whisper count mismatch");

    for (i, entry) in whispers.iter().enumerate() {
        // Compute the body hash (exclude proof + sig + tick —
        // the record-level body is the payload alone).
        let record: formats::records::SignedKeeperWhisper =
            serde_json::from_value(entry.body.clone())
                .expect("record parse");
        let body_hash_hex = hex::encode(record.body_hash());
        assert_eq!(
            body_hash_hex, expected_hashes[i],
            "keeper_whisper {} body hash mismatch", i);
        record.verify()
            .unwrap_or_else(|_| panic!(
                "keeper_whisper {} proof invalid", i));
    }
}
