def demo(artifact_dir=None):
    from pathlib import Path
    import time
    import json as _json
    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
        Ed25519PrivateKey)
    from multiverse_c74 import ChatWorld
    from signed_world_log import SignedLogWorld
    from lobby_server import LobbyServer
    from map_world import (
        MapRegistry, WorldPin, MultiversalMap, MapServer,
        _get_json, _post_json,
    )

    if not HAS_CRYPTO:
        raise RuntimeError("cryptography not installed")
    if artifact_dir is None:
        artifact_dir = "artifacts"
    root = Path(artifact_dir) / "explain_map"
    root.mkdir(parents=True, exist_ok=True)

    def _kp():
        return Ed25519PrivateKey.generate()

    def _world_server(wid, wname):
        kp = _kp()
        signed = SignedLogWorld(ChatWorld(wid, wname), kp)
        srv = LobbyServer(signed, kp, port=0)
        srv.serve_in_thread()
        url = (f"http://127.0.0.1:"
                f"{srv._httpd.server_address[1]}")
        return srv, url, signed.world_signer

    def _map_server(mid, direct=None, subs=None):
        """direct = (wid, url, signer); subs = [(mid, url, signer)]"""
        kp = _kp()
        reg = MapRegistry()
        if direct:
            reg.add(WorldPin(
                direct[0], direct[1], direct[2],
                cluster="Direct"))
        for sub in (subs or []):
            reg.add(WorldPin(
                sub[0], sub[1], sub[2],
                cluster="Sub-Map", kind="map"))
        mv = MultiversalMap(mid, mid, kp, reg)
        signed = SignedLogWorld(mv, kp)
        srv = MapServer(signed, kp, mv, port=0)
        srv.serve_in_thread()
        url = (f"http://127.0.0.1:"
                f"{srv._httpd.server_address[1]}")
        return srv, url, mv.world_signer(), mv, reg

    # Build worlds
    w_chess, w_chess_url, w_chess_sig = _world_server(
        "world:chess", "Chess")
    w_canvas, w_canvas_url, w_canvas_sig = _world_server(
        "world:canvas", "Canvas")
    w_garden, w_garden_url, w_garden_sig = _world_server(
        "world:garden", "Garden")
    w_park, w_park_url, w_park_sig = _world_server(
        "world:park", "Park")
    w_archives, w_archives_url, w_archives_sig = _world_server(
        "world:archives", "Archives")
    time.sleep(0.2)

    # E → archives
    e_srv, e_url, e_sig, e_mv, e_reg = _map_server(
        "map:e",
        direct=("world:archives", w_archives_url,
                 w_archives_sig))
    # D → park + E
    d_srv, d_url, d_sig, d_mv, d_reg = _map_server(
        "map:d",
        direct=("world:park", w_park_url, w_park_sig),
        subs=[("map:e", e_url, e_sig)])
    # C → garden + D + ghost (unreachable)
    ghost_url = "http://127.0.0.1:1"
    c_srv, c_url, c_sig, c_mv, c_reg = _map_server(
        "map:c",
        direct=("world:garden", w_garden_url, w_garden_sig),
        subs=[("map:d", d_url, d_sig),
               ("map:ghost", ghost_url,
                 "did:key:" + "00" * 32)])
    # B → canvas + C
    b_srv, b_url, b_sig, b_mv, b_reg = _map_server(
        "map:b",
        direct=("world:canvas", w_canvas_url,
                 w_canvas_sig),
        subs=[("map:c", c_url, c_sig)])
    # A → chess + B
    a_srv, a_url, a_sig, a_mv, a_reg = _map_server(
        "map:a",
        direct=("world:chess", w_chess_url, w_chess_sig),
        subs=[("map:b", b_url, b_sig)])
    time.sleep(0.2)

    try:
        def explain(target):
            return _get_json(
                f"{a_url}/explain/{target}")

        def render_trace(node, indent=0, label=""):
            prefix = "  " * indent
            marker = "├─" if indent > 0 else "◆"
            elapsed = node.get("elapsed_ms", "?")
            http_ms = node.get("http_ms")
            timing = f"{elapsed}ms"
            if http_ms is not None:
                timing = f"{http_ms}ms→{elapsed}ms"
            print(f"{prefix}{marker} {node['map_id']} "
                  f"@ d{node['depth']}  "
                  f"{node['result']:22s} ({timing})")
            for child in node.get("children", []):
                render_trace(child, indent + 1)

        # --- 3-hop success ---
        e_park = explain("world:park")
        # --- depth exceeded ---
        e_archives = explain("world:archives")
        # --- not found + unreachable ghost ---
        e_ghost = explain("world:nonexistent")
        # --- direct hit ---
        e_chess = explain("world:chess")

        # --- /pin?trace=1 shows the same tree ---
        pin_with_trace = _get_json(
            f"{a_url}/pin/world:park?trace=1")
        # --- /pin without trace (fast path) ---
        pin_no_trace = _get_json(
            f"{a_url}/pin/world:park")

        print("=" * 74)
        print("Recursive map explain — the map shows its work")
        print("=" * 74)
        print()
        print("  Map hierarchy (querying from map:a):")
        print("    map:a ─┬─ world:chess    (direct)")
        print("           └─ map:b")
        print("                 ─┬─ world:canvas   (direct)")
        print("                  └─ map:c")
        print("                       ─┬─ world:garden  (direct)")
        print("                        ├─ map:d")
        print("                        │    ─┬─ world:park (direct)")
        print("                        │     └─ map:e")
        print("                        │          └─ world:archives (direct)")
        print("                        └─ map:ghost  (unreachable)")
        print()
        print("  [1] /explain/world:park — 3-hop success")
        render_trace(e_park["trace"])
        print(f"       found: {e_park['found']}  "
              f"via: {e_park.get('via')}")
        print()
        print("  [2] /explain/world:archives — depth exceeded")
        render_trace(e_archives["trace"])
        print(f"       found: {e_archives['found']}")
        print()
        print("  [3] /explain/world:nonexistent — tried "
              "everything, found nothing")
        render_trace(e_ghost["trace"])
        print(f"       found: {e_ghost['found']}")
        print()
        print("  [4] /explain/world:chess — direct hit")
        render_trace(e_chess["trace"])
        print()
        print("  [5] /pin/world:park?trace=1 — same tree, "
              "via /pin")
        print(f"       trace present: "
              f"{'trace' in pin_with_trace}")
        print(f"       trace matches /explain: "
              f"{pin_with_trace['trace'] == e_park['trace']}")
        print()
        print("  [6] /pin/world:park (no trace) — fast path")
        print(f"       status: {pin_no_trace['status']}")
        print(f"       via:    {pin_no_trace.get('via')}")
        print(f"       trace present: "
              f"{'trace' in pin_no_trace}")
        print()
        print("  What this establishes:")
        print("    - The map explains itself. /explain/<target>")
        print("      returns the full resolution tree: every")
        print("      attempt, its depth, its result, and both")
        print("      its own duration and the parent's HTTP")
        print("      round-trip time.")
        print("    - Failures are diagnosable. 'found: false'")
        print("      with a trace showing 'depth_blocked' at")
        print("      depth 4 tells you exactly why: the world")
        print("      exists but is one map too far.")
        print("    - 'not_found' vs 'unreachable' vs")
        print("      'depth_blocked' vs 'cycle_blocked' are")
        print("      distinct results in the trace. A caller")
        print("      doesn't have to guess which happened.")
        print("    - /pin?trace=1 gives the same tree. Normal")
        print("      /pin (no trace) skips trace collection")
        print("      and stays fast — sub-map queries carry")
        print("      trace=0, so no trace propagates.")
        print("    - Trace collection is per-call. /petition")
        print("      still uses _recursive_resolve (no trace);")
        print("      only /explain and /pin?trace=1 trigger the")
        print("      trace-collecting path.")
        print()
        print("  Honest limits:")
        print("    - Trace size grows with branching. For a map")
        print("      with 10 sub-maps at each of 3 depths, worst")
        print("      case is ~1000 nodes. Typical federations")
        print("      (2-5 sub-maps per map) produce traces of")
        print("      <20 nodes.")
        print("    - Sub-traces are propagated via the /pin")
        print("      response. A /pin?trace=1 query that")
        print("      recurses into 3 sub-maps adds trace data")
        print("      to each sub-map's response, so the")
        print("      /pin?trace=1 response is larger than")
        print("      /pin's. Documented; not a correctness")
        print("      concern.")
        print("    - Timestamps are monotonic-clock durations,")
        print("      not wall-clock. They tell you relative")
        print("      cost, not absolute time.")
        print()
        print("  Anchor (public domain, Emily Dickinson):")
        print("    'The Brain – is wider than the Sky –'")
        print("    'For – put them side by side –'")

        audit = {
            "map_a_url": a_url,
            "explain": {
                "world:park": {
                    "found": e_park["found"],
                    "via": e_park.get("via"),
                    "trace_nodes": _count_nodes(e_park["trace"]),
                },
                "world:archives": {
                    "found": e_archives["found"],
                    "trace_nodes": _count_nodes(
                        e_archives["trace"]),
                },
                "world:nonexistent": {
                    "found": e_ghost["found"],
                    "trace_nodes": _count_nodes(e_ghost["trace"]),
                },
                "world:chess": {
                    "found": e_chess["found"],
                    "trace_nodes": _count_nodes(
                        e_chess["trace"]),
                },
            },
            "pin_with_trace_matches_explain":
                pin_with_trace.get("trace") == e_park["trace"],
            "pin_without_trace_has_no_trace":
                "trace" not in pin_no_trace,
        }
        (root / "explain_map_demo.json").write_text(
            _json.dumps(audit, indent=2))
        print(f"\n  → {root}/explain_map_demo.json")
        return audit
    finally:
        for srv in (a_srv, b_srv, c_srv, d_srv, e_srv,
                     w_chess, w_canvas, w_garden,
                     w_park, w_archives):
            try:
                srv.stop()
            except Exception:
                pass


def _count_nodes(node):
    if node is None:
        return 0
    n = 1
    for child in node.get("children", []):
        n += _count_nodes(child)
    return n
