def demo(artifact_dir=None):
    from pathlib import Path
    import time
    import json as _json
    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
        Ed25519PrivateKey)
    from multiverse_c74 import ChatWorld
    from signed_world_log import SignedLogWorld
    from lobby_server import LobbyServer
    from map_world import (
        MapRegistry, WorldPin, MultiversalMap, MapServer,
        _get_json, _post_json,
    )

    if not HAS_CRYPTO:
        raise RuntimeError("cryptography not installed")
    if artifact_dir is None:
        artifact_dir = "artifacts"
    root = Path(artifact_dir) / "recursive_map"
    root.mkdir(parents=True, exist_ok=True)

    def _kp():
        return Ed25519PrivateKey.generate()

    # ---- 5 worlds, each behind a LobbyServer ----
    world_specs = [
        ("world:chess", "The Chess Park"),
        ("world:canvas", "The Canvas"),
        ("world:garden", "The Garden"),
        ("world:park", "The Park"),
        ("world:archives", "The Archives"),
    ]
    world_urls = {}
    world_signers = {}
    world_servers = []
    for wid, wname in world_specs:
        kp = _kp()
        signed = SignedLogWorld(ChatWorld(wid, wname), kp)
        srv = LobbyServer(signed, kp,
                           description=f"{wname} lobby",
                           port=0)
        srv.serve_in_thread()
        world_servers.append(srv)
        world_urls[wid] = (
            f"http://127.0.0.1:"
            f"{srv._httpd.server_address[1]}")
        world_signers[wid] = signed.world_signer
    time.sleep(0.2)

    # ---- 5 maps: E owns archives, D owns park + E; ... ; A ----
    # Structure:
    #   A → (world:chess | B)
    #   B → (world:canvas | C)
    #   C → (world:garden | D)
    #   D → (world:park | E)
    #   E → (world:archives)  ... reachable only if ≤ MAX_DEPTH
    map_servers = []
    map_urls = {}
    map_signer = {}
    map_regs = {}
    prev_map = None
    for i, mid in enumerate(
            ["map:d", "map:c", "map:b", "map:a"]):
        map_kp = _kp()
        reg = MapRegistry()
        owns = {
            "map:a": "world:chess",
            "map:b": "world:canvas",
            "map:c": "world:garden",
            "map:d": "world:park",
        }[mid]
        reg.add(WorldPin(
            owns, world_urls[owns], world_signers[owns],
            cluster="Direct"))
        if prev_map is not None:
            reg.add(WorldPin(
                prev_map[0], prev_map[1], prev_map[2],
                cluster="Sub-Map", kind="map"))
        mv = MultiversalMap(mid, mid, map_kp, reg)
        signed = SignedLogWorld(mv, map_kp)
        srv = MapServer(signed, map_kp, mv, port=0)
        srv.serve_in_thread()
        map_servers.append(srv)
        url = (f"http://127.0.0.1:"
                f"{srv._httpd.server_address[1]}")
        map_urls[mid] = url
        map_signer[mid] = mv.world_signer()
        map_regs[mid] = reg
        prev_map = (mid, url, mv.world_signer())
    time.sleep(0.2)

    # ---- Map E owns world:archives, sits beyond depth limit ----
    map_e_kp = _kp()
    reg_e = MapRegistry()
    reg_e.add(WorldPin(
        "world:archives", world_urls["world:archives"],
        world_signers["world:archives"], cluster="Direct"))
    mv_e = MultiversalMap("map:e", "map:e", map_e_kp, reg_e)
    signed_e = SignedLogWorld(mv_e, map_e_kp)
    srv_e = MapServer(signed_e, map_e_kp, mv_e, port=0)
    srv_e.serve_in_thread()
    map_servers.append(srv_e)
    time.sleep(0.2)
    map_e_url = (f"http://127.0.0.1:"
                  f"{srv_e._httpd.server_address[1]}")
    map_signer["map:e"] = mv_e.world_signer()
    # Now link E as a sub-map of D
    map_regs["map:d"].add(WorldPin(
        "map:e", map_e_url, mv_e.world_signer(),
        cluster="Sub-Map", kind="map"))
    time.sleep(0.1)

    try:
        # ---- Query A at various targets ----
        def query(map_url, target):
            return _post_json(f"{map_url}/petition", {
                "petitioner_token": "visitor",
                "petitioner_name": "Visitor",
                "passport_admissions": [],
                "message": "",
                "target": target,
            })

        a_url = map_urls["map:a"]

        # 0-hop: A owns world:chess
        r0 = query(a_url, "world:chess")
        # 1-hop: B owns world:canvas
        r1 = query(a_url, "world:canvas")
        # 2-hop: C owns world:garden
        r2 = query(a_url, "world:garden")
        # 3-hop: D owns world:park (at MAX_DEPTH)
        r3 = query(a_url, "world:park")
        # 4-hop: E owns world:archives (exceeds MAX_DEPTH)
        r4 = query(a_url, "world:archives")

        def route_ok(resp):
            return (resp.get("kind") == "route"
                    and "target_manifest" in resp)

        def via_in(resp):
            reason = resp.get("reason", "")
            return reason

        # ---- Cycle: add A as sub-map of E, query E for unknown ----
        map_regs["map:e"].add(WorldPin(
            "map:a", map_urls["map:a"], map_signer["map:a"],
            cluster="Sub-Map", kind="map"))
        cycle_resp = query(map_e_url, "world:nonexistent")
        cycle_refused = cycle_resp.get("kind") == "refusal"

        # ---- Recursive /pin direct inspection ----
        pin_park = _get_json(
            f"{a_url}/pin/world:park")
        pin_archives = _get_json(
            f"{a_url}/pin/world:archives")

        # ---- Print ----
        print("=" * 74)
        print("Recursive sub-map resolution — chain of maps")
        print("=" * 74)
        print()
        print(f"  Map hierarchy:")
        print(f"    map:a  ─┬─ world:chess (direct)")
        print(f"            └─ map:b")
        print(f"                 ─┬─ world:canvas (direct)")
        print(f"                  └─ map:c")
        print(f"                       ─┬─ world:garden (direct)")
        print(f"                        └─ map:d")
        print(f"                             ─┬─ world:park (direct)")
        print(f"                              └─ map:e")
        print(f"                                   └─ world:archives (direct)")
        print()
        print(f"  MAX_DEPTH = 3 (up to 3 sub-map hops from querying map)")
        print()
        print("  Queries from map:a:")
        for label, resp, expected_ok in [
            ("world:chess",    r0, True),
            ("world:canvas",   r1, True),
            ("world:garden",   r2, True),
            ("world:park",     r3, True),
            ("world:archives", r4, False),
        ]:
            ok = route_ok(resp)
            marker = "✓" if ok else "✗"
            reason = via_in(resp) or resp.get("reason", "")
            print(f"    {marker} {label:16s} "
                  f"{'routed' if ok else 'refused':8s}  "
                  f"{reason[:60]}")
        print()
        print(f"  Cycle prevention (map:e → map:a, target unknown):")
        print(f"    {cycle_refused}  "
              f"({cycle_resp.get('reason', '')})")
        print()
        print(f"  Direct /pin inspection from map:a:")
        if pin_park.get("status") != "not_registered":
            print(f"    world:park:    via={pin_park.get('via')}")
        if pin_archives.get("status") == "not_registered":
            print(f"    world:archives: not registered "
                  f"(depth exceeded)")
        print()
        print("  What this establishes:")
        print("    - Sub-map queries recurse. A map can ask its")
        print("      sub-maps, which ask their sub-maps, up to")
        print("      MAX_DEPTH hops. Provenance (via chain) grows")
        print("      at each hop and is preserved in the answer.")
        print("    - Depth is bounded. world:park (4 maps away)")
        print("      routes; world:archives (5 maps away) does")
        print("      not. MAX_DEPTH prevents unbounded recursion.")
        print("    - Cycles are prevented independently. The")
        print("      visited set travels with every query; a map")
        print("      that has been visited is never visited again.")
        print("    - The /pin endpoint is itself the recursive")
        print("      resolver. Callers get the same answer whether")
        print("      they query a map directly or navigate via")
        print("      /petition — the depth and visited params")
        print("      propagate the recursion transparently.")
        print()
        print("  Honest limit: depth and cycle defenses are")
        print("  heuristic. A cleverly arranged federation could")
        print("  still spend all of MAX_DEPTH on unproductive")
        print("  branches before reaching the answer. A smarter")
        print("  resolver would use a heuristic order or")
        print("  memoization; not built.")
        print()
        print("  Anchor (public domain, Emily Dickinson):")
        print("    'The Brain – is wider than the Sky –'")
        print("    'For – put them side by side –'")

        audit = {
            "max_depth": 3,
            "queries": {
                "world:chess": {
                    "routed": route_ok(r0),
                    "reason": r0.get("reason", ""),
                },
                "world:canvas": {
                    "routed": route_ok(r1),
                    "reason": r1.get("reason", ""),
                },
                "world:garden": {
                    "routed": route_ok(r2),
                    "reason": r2.get("reason", ""),
                },
                "world:park": {
                    "routed": route_ok(r3),
                    "reason": r3.get("reason", ""),
                },
                "world:archives": {
                    "routed": route_ok(r4),
                    "reason": r4.get("reason", ""),
                },
            },
            "cycle_prevented": cycle_refused,
        }
        (root / "recursive_map_demo.json").write_text(
            _json.dumps(audit, indent=2))
        print(f"\n  → {root}/recursive_map_demo.json")
        return audit
    finally:
        for srv in map_servers + world_servers:
            try:
                srv.stop()
            except Exception:
                pass
