def demo(artifact_dir=None):
    from pathlib import Path
    import json as _json
    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
        Ed25519PrivateKey)
    from chaos_game_world import ChaosGameWorld, SIERPINSKI
    from elementary_ca_world import ElementaryCAWorld, rule_90
    from unified_individual import (
        UnifiedIndividualSession, pack_unified_bundle,
        verify_unified_individual_with_adapters,
    )
    from coupled_learners import TinyRNN
    from microverse_adapter import MicroverseAdapter

    if not HAS_CRYPTO:
        raise RuntimeError("cryptography not installed")
    if artifact_dir is None:
        artifact_dir = "artifacts"
    root = Path(artifact_dir) / "microverse"
    root.mkdir(parents=True, exist_ok=True)

    def _kp():
        return Ed25519PrivateKey.generate()

    # ---- Microverse ----
    mv_kp = _kp()
    mv = MicroverseWorld(
        "world:microverse", "The Microverse", mv_kp,
        description="a park where fractal worlds grow")

    # ---- Hosts ----
    chaos_kp = _kp()
    chaos_world = ChaosGameWorld(
        preset=SIERPINSKI, growth_mode="seeded_random",
        initial_point=(500, 500), keypair=chaos_kp,
        prng_seed=0xAAAA)
    chaos_host = ChaosGameHost(
        "host:sierpinski", chaos_world,
        _did_from_kp(chaos_kp),
        description="a Sierpinski that grows by choice")

    eca_kp = _kp()
    eca_world = ElementaryCAWorld(
        params=rule_90(), initial_cells=[0], keypair=eca_kp)
    eca_host = ElementaryCAHost(
        "host:eca", eca_world,
        _did_from_kp(eca_kp),
        description="a Pascal's triangle at rule 90")

    mv.add_host(chaos_host)
    mv.add_host(eca_host)

    # ---- Two individuals ----
    alice_kp = _kp()
    alice = UnifiedIndividualSession(
        individual_kp=alice_kp,
        model=TinyRNN(n_actions=3, hidden=4,
                       n_extra_inputs=0, seed=100))
    alice.enter_world_via_adapter(MicroverseAdapter(), {
        "world_id": mv.manifest().entity_id,
        "world": mv,
        "world_signer": mv.world_signer(),
        "display_name": "Alice-bot",
    })

    bob_kp = _kp()
    bob = UnifiedIndividualSession(
        individual_kp=bob_kp,
        model=TinyRNN(n_actions=3, hidden=4,
                       n_extra_inputs=0, seed=200))
    bob.enter_world_via_adapter(MicroverseAdapter(), {
        "world_id": mv.manifest().entity_id,
        "world": mv,
        "world_signer": mv.world_signer(),
        "display_name": "Bob-bot",
    })

    # ---- Run 5 cycles: agents act, microverse advances ----
    for cycle in range(5):
        # Each agent acts twice per cycle
        for _ in range(2):
            alice.step_via_adapter()
            bob.step_via_adapter()
        # Microverse advances both hosts one step
        mv.advance_cycle(n_steps=1)

    # ---- Curator rearranges the park: retire ECA, add a new chaos ----
    mv.retire_host("host:eca")

    new_kp = _kp()
    new_world = ChaosGameWorld(
        preset=SIERPINSKI, growth_mode="seeded_random",
        initial_point=(500, 500), keypair=new_kp,
        prng_seed=0xBBBB)
    new_host = ChaosGameHost(
        "host:sierpinski-2", new_world,
        _did_from_kp(new_kp),
        description="a second Sierpinski, newly planted")
    mv.add_host(new_host)

    # ---- Agents continue in the reorganized park ----
    for cycle in range(5, 8):
        for _ in range(2):
            alice.step_via_adapter()
            bob.step_via_adapter()
        mv.advance_cycle(n_steps=1)

    # ---- Pack and verify ----
    alice_bundle = pack_unified_bundle(
        alice, persona="Alice-bot, a microverse resident",
        name="Alice-bot", initial_seed=100)
    bob_bundle = pack_unified_bundle(
        bob, persona="Bob-bot, a microverse resident",
        name="Bob-bot", initial_seed=200)

    world_logs = {
        mv.manifest().entity_id: list(mv.log_since(None)),
    }
    v_a = verify_unified_individual_with_adapters(
        alice_bundle, world_logs)
    v_b = verify_unified_individual_with_adapters(
        bob_bundle, world_logs)

    v_mv_log = mv.verify_log()
    v_xref = mv.verify_cross_references()

    # ---- Print ----
    print("=" * 74)
    print("Microverse — fractal worlds as social scenery")
    print("=" * 74)
    print()
    print(f"  Microverse: {mv.manifest().entity_id}")
    print(f"  Signer:     {mv.world_signer()[:24]}...")
    print(f"  Description: {mv.description()}")
    print()
    print(f"  Hosts (during cycle 4):")
    print(f"    host:sierpinski   — a Sierpinski that grows by choice")
    print(f"    host:eca          — Pascal's triangle at rule 90")
    print(f"  Hosts (during cycle 7, after curator reorg):")
    print(f"    host:sierpinski   — a Sierpinski that grows by choice")
    print(f"    host:sierpinski-2 — a second Sierpinski, newly planted")
    print()
    print(f"  Agents: Alice-bot, Bob-bot")
    print(f"  Total cycles: {mv.cycle()}")
    print(f"  Microverse log: {len(mv.log_since(None))} entries")
    print()
    print("  Sample of the log:")
    entries = mv.log_since(None)
    for e in entries[:12]:
        actor = e.get("actor", "")[:16] + "..." \
            if e.get("actor") else ""
        kind = e["kind"]
        detail = ""
        if kind == "admission":
            detail = e.get("name", "")
        elif kind == "agent_moved":
            detail = f"→ {e.get('to')}"
        elif kind == "agent_observed":
            detail = (f"at {e.get('host_world_id')}, "
                      f"event {e.get('observed_event_hash', '')[:12]}...")
        elif kind == "agent_spoke":
            detail = f"\"{e.get('text', '')}\""
        elif kind == "host_added":
            detail = e.get("host_world_id", "")
        elif kind == "host_retired":
            detail = e.get("host_world_id", "")
        elif kind == "cycle_advanced":
            detail = f"cycle {e.get('cycle')}, " \
                      f"{len(e.get('host_event_hashes', []))} host events"
        print(f"    {kind:20s}  {actor:20s}  {detail}")
    if len(entries) > 12:
        print(f"    ... ({len(entries) - 12} more entries)")
    print()
    print("  Verification:")
    print(f"    Alice bundle:          {v_a[0]}  ({v_a[1]})")
    print(f"    Bob bundle:            {v_b[0]}  ({v_b[1]})")
    print(f"    Microverse log:        {v_mv_log[0]}  "
          f"({v_mv_log[1]})")
    print(f"    Cross-references:      {v_xref[0]}  "
          f"({v_xref[1]})")
    print()
    print("  What this establishes:")
    print("    - The Microverse is a *social* world. Agents")
    print("      move, observe, and speak. Its log is the")
    print("      record of their acts.")
    print("    - Fractal worlds are hosted. The chaos game")
    print("      and elementary CA run on their own schedules;")
    print("      the Microverse advances them each cycle. Their")
    print("      logs are their own — separate from the")
    print("      Microverse log.")
    print("    - Cross-references bind the logs. Every")
    print("      'agent_observed' entry references a specific")
    print("      host event hash. Verifiers walk the chain:")
    print("      agent act → Microverse log → host event →")
    print("      signed world step.")
    print("    - The curator is the keeper of the park.")
    print("      Adding a host, retiring a host — these are")
    print("      keeper acts, logged like any other. Agents")
    print("      respond: focus moves to the new host, ")
    print("      observations point at its events.")
    print("    - The verification composition is:")
    print("      unified bundle + Microverse log + host worlds")
    print("      all verifiable, all linked by cross-references.")
    print()
    print("  Honest limit: the Microverse is a *habitat*, not")
    print("  a full social simulation. Agents move, observe,")
    print("  speak — no tasks, roles, or complex relationships.")
    print("  The point is the hosting pattern, which composes")
    print("  with anything: any fractal world, any game world,")
    print("  any artifact.")
    print()
    print("  Anchor (public domain, Emily Dickinson):")
    print("    'I dwell in Possibility –'")
    print("    'A fairer House than Prose –'")

    audit = {
        "microverse_id": mv.manifest().entity_id,
        "signer": mv.world_signer(),
        "cycles": mv.cycle(),
        "final_hosts": list(mv.hosts().keys()),
        "log_entries": len(mv.log_since(None)),
        "verification": {
            "alice_bundle": v_a[0],
            "bob_bundle": v_b[0],
            "microverse_log": v_mv_log[0],
            "cross_references": v_xref[0],
        },
    }
    (root / "microverse_demo.json").write_text(
        _json.dumps(audit, indent=2))
    print(f"\n  → {root}/microverse_demo.json")
    return audit
