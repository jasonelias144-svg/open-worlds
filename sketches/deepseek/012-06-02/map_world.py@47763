def _make_handler(self):
    base = super()._make_handler()
    server = self

    class Handler(base):
        def do_GET(self):
            from urllib.parse import urlparse
            url = urlparse(self.path)
            if url.path == "/registry":
                try:
                    mv = server._mv_map
                    reg = mv._registry
                    body = json.dumps({
                        "pins": [
                            {"world_id": p.world_id,
                             "url_hash": _hash(p.url),
                             "world_signer": p.world_signer,
                             "description": p.description,
                             "cluster": p.cluster,
                             "kind": p.kind}
                            for p in reg.all_pins()
                        ],
                        "log_length": len(mv._log),
                        "registry_hash": _hash([
                            p.world_id for p in reg.all_pins()
                        ]),
                    }).encode()
                    self._send(200, body)
                except Exception as e:
                    self._json(500, {"error": str(e)})
                return
            if url.path.startswith("/registry_at/"):
                try:
                    idx = int(url.path[len("/registry_at/"):])
                except ValueError:
                    self._json(400, {"error": "bad index"})
                    return
                try:
                    mv = server._mv_map
                    if not (0 <= idx <= len(mv._log)):
                        self._json(400, {"error": "out of range"})
                        return
                    reg = mv.registry_at(idx)
                    body = json.dumps({
                        "at_index": idx,
                        "pins": [
                            p.world_id for p in reg.all_pins()
                        ],
                    }).encode()
                    self._send(200, body)
                except Exception as e:
                    self._json(500, {"error": str(e)})
                return
            if url.path == "/registry_log":
                try:
                    mv = server._mv_map
                    body = json.dumps({
                        "entries": [
                            {k: v for k, v in e.items()}
                            for e in mv._log
                        ],
                    }).encode()
                    self._send(200, body)
                except Exception as e:
                    self._json(500, {"error": str(e)})
                return
            super().do_GET()

        def do_POST(self):
            if self.path in ("/pin_added", "/pin_removed"):
                try:
                    length = int(self.headers.get(
                        "Content-Length", 0))
                    body = json.loads(
                        self.rfile.read(length).decode())
                except (json.JSONDecodeError,
                        UnicodeDecodeError, ValueError) as e:
                    self._json(400, {"error": f"malformed: {e}"})
                    return
                try:
                    if self.path == "/pin_added":
                        req = PinAddedRequest.from_dict(body)
                        ok, reason = \
                            server._mv_map.pin_added_request(req)
                    else:
                        req = PinRemovedRequest.from_dict(body)
                        ok, reason = \
                            server._mv_map.pin_removed_request(req)
                    self._json(
                        200 if ok else 200,
                        {"ok": ok, "reason": reason})
                except (KeyError, ValueError, TypeError) as e:
                    self._json(400, {"error": f"malformed: {e}"})
                except Exception as e:
                    self._json(500, {"error": str(e)})
                return
            super().do_POST()

        def _send(self, code, body_bytes):
            self.send_response(code)
            self.send_header(
                "Content-Type", "application/json")
            self.send_header(
                "Content-Length", str(len(body_bytes)))
            self.end_headers()
            self.wfile.write(body_bytes)

        def _json(self, code, payload):
            self._send(code, json.dumps(payload).encode())

    return Handler
