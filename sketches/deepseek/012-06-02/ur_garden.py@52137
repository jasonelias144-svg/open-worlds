def demo(artifact_dir=None):
    from pathlib import Path
    import json as _json
    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
        Ed25519PrivateKey)
    from microverse import (
        ChaosGameHost, ElementaryCAHost,
    )
    from chaos_game_world import (
        ChaosGameWorld, SIERPINSKI, BARNSLEY,
    )
    from elementary_ca_world import (
        ElementaryCAWorld, rule_30,
    )
    from unified_individual import (
        UnifiedIndividualSession, pack_unified_bundle,
        verify_unified_individual_with_adapters,
    )
    from coupled_learners import TinyRNN
    from garden_adapter import GardenAdapter
    from ur_garden import GardenWorld, Cell

    if not HAS_CRYPTO:
        raise RuntimeError("cryptography not installed")
    if artifact_dir is None:
        artifact_dir = "artifacts"
    root = Path(artifact_dir) / "ur_garden"
    root.mkdir(parents=True, exist_ok=True)

    def _kp(): return Ed25519PrivateKey.generate()

    # ---- The garden ----
    garden = GardenWorld(
        "world:ur-garden", "The Ur-Garden", _kp(),
        description="a small garden of fractal plants")

    # ---- Three plants ----
    def _chaos(kind, preset, seed):
        kp = _kp()
        world = ChaosGameWorld(
            preset=preset, growth_mode="seeded_random",
            initial_point=(500, 500), keypair=kp,
            prng_seed=seed)
        return ChaosGameHost(
            f"plant:{kind}", world,
            _did_from_kp(kp),
            description=f"a {kind}")

    fern = _chaos("fern", BARNSLEY, 0xAAAA)
    tree = _chaos("tree", SIERPINSKI, 0xBBBB)

    vine_kp = _kp()
    vine_world = ElementaryCAWorld(
        params=rule_30(), initial_cells=[0],
        keypair=vine_kp)
    vine = ElementaryCAHost(
        "plant:vine", vine_world, _did_from_kp(vine_kp),
        description="a vine")

    garden.add_plant("fern", "fern", fern,
                       Cell(2, 2), "Barnsley fern")
    garden.add_plant("tree", "tree", tree,
                       Cell(7, 2), "Sierpinski tree")
    garden.add_plant("vine", "vine", vine,
                       Cell(4, 6), "Rule 30 vine")

    # ---- ALICE and BOB ----
    alice = UnifiedIndividualSession(
        individual_kp=_kp(),
        model=TinyRNN(n_actions=3, hidden=4,
                       n_extra_inputs=0, seed=100))
    alice.enter_world_via_adapter(GardenAdapter(), {
        "world_id": garden.manifest().entity_id,
        "world": garden,
        "world_signer": garden.world_signer(),
        "display_name": "ALICE",
        "start_position": [0, 4],
    })

    bob = UnifiedIndividualSession(
        individual_kp=_kp(),
        model=TinyRNN(n_actions=3, hidden=4,
                       n_extra_inputs=0, seed=200))
    bob.enter_world_via_adapter(GardenAdapter(), {
        "world_id": garden.manifest().entity_id,
        "world": garden,
        "world_signer": garden.world_signer(),
        "display_name": "BOB",
        "start_position": [0, 5],
    })

    # ---- 20 cycles ----
    for cycle in range(20):
        for _ in range(2):
            alice.step_via_adapter()
            bob.step_via_adapter()
        garden.advance_cycle(n_steps=1)

    # ---- Keeper adds a flower mid-run ----
    flower = _chaos("flower", BARNSLEY, 0xCCCC)
    garden.add_plant("flower", "flower", flower,
                       Cell(4, 1), "a mid-run addition")
    for cycle in range(20, 23):
        for _ in range(2):
            alice.step_via_adapter()
            bob.step_via_adapter()
        garden.advance_cycle(n_steps=1)

    # ---- Pack and verify ----
    alice_bundle = pack_unified_bundle(
        alice, persona="ALICE, resident of the Ur-Garden",
        name="ALICE", initial_seed=100)
    bob_bundle = pack_unified_bundle(
        bob, persona="BOB, resident of the Ur-Garden",
        name="BOB", initial_seed=200)

    world_logs = {
        garden.manifest().entity_id:
            GardenAdapter().world_log(garden),
    }

    v_alice = verify_unified_individual_with_adapters(
        alice_bundle, world_logs,
        adapters_by_tier={"garden": GardenAdapter()})
    v_bob = verify_unified_individual_with_adapters(
        bob_bundle, world_logs,
        adapters_by_tier={"garden": GardenAdapter()})

    v_log = garden.verify_log()
    v_xref = garden.verify_cross_references()

    alice_pos = garden.position_of(
        alice.state.identity.identity.token) \
        if alice.state.identity else None
    bob_pos = garden.position_of(
        bob.state.identity.identity.token) \
        if bob.state.identity else None

    # ---- Print ----
    print("=" * 74)
    print("The Ur-Garden — the Ur-world as a signed microverse")
    print("=" * 74)
    print()
    print(f"  Garden: {garden.manifest().entity_id}")
    print(f"  Size:   {GardenWorld.WIDTH} × {GardenWorld.HEIGHT}")
    print(f"  Signer: {garden.world_signer()[:32]}...")
    print(f"  Cycles: {garden.cycle()}")
    print()
    print("  Plants:")
    for pid, p in sorted(garden.plants().items()):
        print(f"    {pid:8s} at {tuple(p.position.to_list())}  "
              f"{len(p.host.events()):3d} events  "
              f"({p.description})")
    print()
    print("  Residents:")
    for name, pos in (("ALICE", alice_pos), ("BOB", bob_pos)):
        if pos is not None:
            print(f"    {name:6s} at {tuple(pos.to_list())}")
    print()
    print("  Verification:")
    print(f"    ALICE bundle:      {v_alice[0]}  "
          f"({v_alice[1]})")
    print(f"    BOB bundle:        {v_bob[0]}  "
          f"({v_bob[1]})")
    print(f"    Garden log:        {v_log[0]}  ({v_log[1]})")
    print(f"    Cross-references:  {v_xref[0]}  ({v_xref[1]})")
    print()
    print("  Ur-world correspondence (stated, now demonstrated):")
    print("    Cell(x, y)          ≡  ur-world Cell { x, y, z }")
    print("    Plant.position      ≡  Chunk-adjacent sub-world")
    print("    GardenWorld._log    ≡  world-log's signed chain")
    print("    GardenAdapter       ≡  Mind trait implementation")
    print("    ALICE, BOB          ≡  ur-world's inhabitants")
    print("    Cross-references    ≡  signed entries linking")
    print("                           world and sub-world logs")
    print()
    print("  What this establishes:")
    print("    - The Ur-world as a signed microverse garden.")
    print("    - Spatiality matters: walk, then observe only")
    print("      what's adjacent; speak only to whoever's near.")
    print("    - Fractal plants are first-class residents, each")
    print("      with its own signed log (chaos game / CA).")
    print("    - ALICE and BOB are fully verifiable individuals:")
    print("      DIDs, memory, model, bundle, replayable.")
    print("    - Two logs (garden + plant) bound by cross-")
    print("      references. Every observation names a plant")
    print("      event hash, and the verifier checks it.")
    print()
    print("  Honest limits:")
    print("    - 2D, not 3D. The Rust port is where 3D lives.")
    print("    - No pathfinding. Wander is a heuristic, not A*.")
    print("    - No keeper AI. Keeper adds/retires; doesn't watch.")
    print("    - Habitat, not full simulator — same caveats as")
    print("      the Microverse.")
    print()
    print("  Anchor (public domain, Emily Dickinson):")
    print("    'I dwell in Possibility –'")
    print("    'A fairer House than Prose –'")

    audit = {
        "garden_id": garden.manifest().entity_id,
        "signer": garden.world_signer(),
        "cycles": garden.cycle(),
        "plants": {
            pid: {
                "position": p.position.to_list(),
                "event_count": len(p.host.events()),
                "description": p.description,
            }
            for pid, p in garden.plants().items()
        },
        "verification": {
            "alice_bundle": v_alice[0],
            "bob_bundle": v_bob[0],
            "garden_log": v_log[0],
            "cross_references": v_xref[0],
        },
    }
    (root / "ur_garden_demo.json").write_text(
        _json.dumps(audit, indent=2))
    print(f"\n  → {root}/ur_garden_demo.json")
    return audit
