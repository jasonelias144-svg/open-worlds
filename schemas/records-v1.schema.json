{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonelias144-svg/open-worlds/schemas/records-v1.schema.json",
  "title": "open-worlds records, version 1",
  "description": "The records the offices keep (course step 2): a grant, a decision record, a suggestion, a rating, and a signed log head; an arrival, signed by the one who enters a world; an individual's sealed records: a world-key and a journal entry, with the sealed box they travel in; and the records of who an individual and a world are: identity, birth record, mind record, and a world's birth record; a world's template, with its dials; the project's key list; a person's links to their presences (holds and held-by) and their list of them (course step 3a); and a council's proposal and a person's vote on it (course step 3a, the council). Each record is signed with eddsa-jcs-2022 (formats/proof.py); formats/records.py, formats/sealed.py and rust/formats check them, and docs/research/FORMATS.md says why each field is there.",
  "$defs": {
    "didKey": {
      "description": "An Ed25519 public key as a did:key; an individual's, a world's or an office's.",
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "hash": {
      "description": "SHA-256, lowercase hex: of a record, the SHA-256 of its RFC 8785 form, proof included.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tick": {
      "description": "A tick of the log the record belongs to.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time": {
      "description": "A UTC time to the second.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "actKind": {
      "description": "A kind of act, from the list the rules fix.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "text": {
      "description": "Text a person or a mind writes: not empty, not only spaces or line breaks of any kind, and no control characters (C0, DEL or C1) but tab and line breaks.",
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \\t\\n\\r\\u000b\\u000c\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001f\\u007f-\\u0084\\u0086-\\u009f]*$"
        }
      ]
    },
    "proof": {
      "description": "An eddsa-jcs-2022 Data Integrity proof, read as formats/proof.py reads it: one proof, did:key, no @context.",
      "type": "object",
      "properties": {
        "type": {
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022"
        },
        "created": {
          "$ref": "#/$defs/time"
        },
        "verificationMethod": {
          "type": "string",
          "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}#z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$",
          "maxLength": 100
        }
      },
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "additionalProperties": false
    },
    "grant": {
      "description": "A power, written down: who gives it, who holds it, what it allows, where, until when, and the grant it narrows. Signed by its issuer (docs/ADMIN.md, layer 2; docs/research/FORMATS.md, Grants).",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/grant/v1"
        },
        "issuer": {
          "$ref": "#/$defs/didKey"
        },
        "holder": {
          "$ref": "#/$defs/didKey"
        },
        "allows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actKind"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "within": {
          "description": "The world it holds in, or the whole multiverse.",
          "oneOf": [
            {
              "$ref": "#/$defs/didKey"
            },
            {
              "const": "multiverse"
            }
          ]
        },
        "validFrom": {
          "$ref": "#/$defs/time"
        },
        "validUntil": {
          "$ref": "#/$defs/time"
        },
        "narrows": {
          "description": "The grant this one narrows; absent for a grant an office issues from its own powers.",
          "$ref": "#/$defs/hash"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "issuer",
        "holder",
        "allows",
        "within",
        "validFrom",
        "proof"
      ],
      "additionalProperties": false
    },
    "decision": {
      "description": "An office's decision that affects others, with its reasons (docs/REASONS.md). Signed by the office.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/decision/v1"
        },
        "office": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/didKey"
            },
            "grant": {
              "$ref": "#/$defs/hash"
            }
          },
          "required": [
            "key",
            "grant"
          ],
          "additionalProperties": false
        },
        "act": {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/actKind"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hash"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "records"
          ],
          "additionalProperties": false
        },
        "affects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/didKey"
          },
          "uniqueItems": true
        },
        "reasons": {
          "$ref": "#/$defs/text",
          "maxLength": 20000
        },
        "grounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "charter",
                  "law",
                  "rule",
                  "record"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false,
            "if": {
              "properties": {
                "kind": {
                  "const": "record"
                }
              }
            },
            "then": {
              "properties": {
                "ref": {
                  "$ref": "#/$defs/hash"
                }
              }
            },
            "description": "What a decision rests on: a section of the charter, a world's law, a rule, or an earlier record, which is named by its hash."
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "uniqueItems": true
        },
        "formal": {
          "description": "A proof in Lean, by hash, of a property the rules name for this kind of act.",
          "type": "object",
          "properties": {
            "property": {
              "$ref": "#/$defs/actKind"
            },
            "proof": {
              "$ref": "#/$defs/hash"
            },
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+/[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "property",
            "proof",
            "model"
          ],
          "additionalProperties": false
        },
        "views": {
          "description": "ADMIN's only: each council member's view.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "view": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "member",
              "view"
            ],
            "additionalProperties": false
          }
        },
        "supersedes": {
          "$ref": "#/$defs/hash"
        },
        "appeal": {
          "description": "Where an appeal goes.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "office",
        "act",
        "affects",
        "reasons",
        "grounds",
        "inputs",
        "appeal",
        "tick",
        "proof"
      ],
      "additionalProperties": false
    },
    "suggestion": {
      "description": "A suggestion from inside, to a world's Keeper or to ADMIN: one way, in the open (docs/ADMIN.md, Suggestions from inside). Signed by its author.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/suggestion/v1"
        },
        "author": {
          "$ref": "#/$defs/didKey"
        },
        "to": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "office": {
                  "const": "admin"
                }
              },
              "required": [
                "office"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "office": {
                  "const": "keeper"
                },
                "world": {
                  "$ref": "#/$defs/didKey"
                }
              },
              "required": [
                "office",
                "world"
              ],
              "additionalProperties": false
            }
          ]
        },
        "about": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "keeper",
                "world",
                "admin",
                "multiverse",
                "project"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "keeper",
                  "world"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/didKey"
              }
            }
          }
        },
        "text": {
          "$ref": "#/$defs/text",
          "maxLength": 10000
        },
        "floor": {
          "description": "Marked by its author as reporting a breach of the floor, which doesn't wait.",
          "type": "boolean"
        },
        "world": {
          "description": "The world it was made in; absent when made outside any world, by ADMIN or a Keeper in the multiverse.",
          "$ref": "#/$defs/didKey"
        },
        "tick": {
          "description": "A tick of the log it belongs to: its world's, or the multiverse's.",
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "author",
        "to",
        "text",
        "tick",
        "proof"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "description": "A suggestion to ADMIN about a Keeper or a world names which, by key.",
          "if": {
            "properties": {
              "to": {
                "properties": {
                  "office": {
                    "const": "admin"
                  }
                },
                "required": [
                  "office"
                ]
              },
              "about": {
                "properties": {
                  "kind": {
                    "enum": [
                      "keeper",
                      "world"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "to",
              "about"
            ]
          },
          "then": {
            "properties": {
              "about": {
                "required": [
                  "ref"
                ]
              }
            }
          }
        }
      ]
    },
    "rating": {
      "description": "A suggestion's author's rating, 1 to 5, of how it was handled. Signed by that author.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/rating/v1"
        },
        "author": {
          "$ref": "#/$defs/didKey"
        },
        "suggestion": {
          "$ref": "#/$defs/hash"
        },
        "outcome": {
          "$ref": "#/$defs/hash"
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "text": {
          "$ref": "#/$defs/text",
          "maxLength": 2000
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "author",
        "suggestion",
        "outcome",
        "score",
        "proof"
      ],
      "additionalProperties": false
    },
    "logHead": {
      "description": "A signed head: a world's signature over its log's length and last hash at a tick, so a log cut short or shown two ways is caught (docs/research/FORMATS.md). Signed by the world.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/log-head/v1"
        },
        "world": {
          "$ref": "#/$defs/didKey"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last": {
          "description": "The hash of the log's last entry; for an empty log, sixty-four zeros, as a first entry's prev.",
          "$ref": "#/$defs/hash"
        },
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "world",
        "length",
        "last",
        "tick",
        "proof"
      ],
      "additionalProperties": false
    },
    "arrival": {
      "description": "An arrival: the individual's own signature on entering a world, under a name, at a tick, just after a given entry of the world's log, so that whoever comes back with the same key is known as the same individual, and one arrival can't be used twice in one history (docs/research/KEYS.md, decisions 11 to 17). Signed by the individual.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/arrival/v1"
        },
        "world": {
          "description": "The world entered: its did:key.",
          "$ref": "#/$defs/didKey"
        },
        "individual": {
          "description": "Who enters: their did:key, which signs.",
          "$ref": "#/$defs/didKey"
        },
        "name": {
          "description": "The name they enter under.",
          "$ref": "#/$defs/name"
        },
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "previous": {
          "description": "The hash of the world's log entry just before the arrival's own (the log's own hash, as world-log writes it), which the world must hold as its last.",
          "$ref": "#/$defs/hash"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "world",
        "individual",
        "name",
        "tick",
        "previous",
        "proof"
      ],
      "additionalProperties": false
    },
    "worldKey": {
      "description": "The world-key: the right to found a world, earned by walking a path to its end. Signed by the world that placed the path (the Ur-world), naming the one who earned it, who alone may use it; it is given sealed to them (docs/WORLD-KEY.md, \"The world-key\").",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/world-key/v1"
        },
        "issuer": {
          "description": "The world that placed the path, and signs.",
          "$ref": "#/$defs/didKey"
        },
        "holder": {
          "description": "The one who earned it; the only one it is sealed to, and the only one a world honours it from.",
          "$ref": "#/$defs/didKey"
        },
        "path": {
          "description": "The path walked, by the hash of its record in the public log.",
          "$ref": "#/$defs/hash"
        },
        "tick": {
          "description": "The tick of the issuer's log at which its code confirmed the path done.",
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "issuer",
        "holder",
        "path",
        "tick",
        "proof"
      ],
      "additionalProperties": false
    },
    "journalEntry": {
      "description": "An entry in an individual's journal, in their own words. Signed by its author and sealed to them alone; only the sealed box's fingerprint is public (docs/MINDS.md, \"Memory\").",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/journal-entry/v1"
        },
        "author": {
          "$ref": "#/$defs/didKey"
        },
        "world": {
          "description": "The world it was written in.",
          "$ref": "#/$defs/didKey"
        },
        "tick": {
          "description": "The tick of that world's log when it was written.",
          "$ref": "#/$defs/tick"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "remembers": {
          "description": "The events it remembers, each by the world and the tick of that world's log where it happened, so a memory without a record behind it shows.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "world": {
                "$ref": "#/$defs/didKey"
              },
              "tick": {
                "$ref": "#/$defs/tick"
              }
            },
            "required": [
              "world",
              "tick"
            ],
            "additionalProperties": false
          }
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "author",
        "world",
        "tick",
        "text",
        "proof"
      ],
      "additionalProperties": false
    },
    "redactedField": {
      "description": "A field that was redacted from a log, as it was. Signed by the office that redacted it and sealed to one who may hold it: a person it is about, or the office that decides whether it stays redacted (docs/research/REDACTION.md, decisions 4 and 5). Whoever opens it hashes what it holds and finds that fingerprint in the log, and that binds the record to its place. Its envelope says in the clear that it holds a redacted field and whom it is for, so it is not placed in the open: it goes to the one it names.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/redacted-field/v1"
        },
        "office": {
          "description": "The office that redacted the field, and signs: its key, and the grant it acts under.",
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/didKey"
            },
            "grant": {
              "$ref": "#/$defs/hash"
            }
          },
          "required": [
            "key",
            "grant"
          ],
          "additionalProperties": false
        },
        "to": {
          "description": "The one this copy is sealed to, and the only one it is for.",
          "$ref": "#/$defs/didKey"
        },
        "decider": {
          "description": "The office that decides whether the field stays redacted, by its key. Every copy names it, so each reader knows who else holds one. The copy that names the same key as its reader is the deciding office's own.",
          "$ref": "#/$defs/didKey"
        },
        "log": {
          "description": "The log the field was in, by the hash of its first entry.",
          "$ref": "#/$defs/hash"
        },
        "entry": {
          "description": "The entry the field was in, by its hash in that log.",
          "$ref": "#/$defs/hash"
        },
        "field": {
          "description": "The field's name, as the log's table has it.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "hashed": {
          "description": "What was there: the exact text the field's fingerprint in the log is the SHA-256 of. It is the list of the field's salt, its name and its value, written as the log writes it (world/apart.py). It is carried as it was hashed, so that whatever a log can keep apart can be carried, and nothing is lost between two ways of writing JSON. Whether it is that text is checked against the log, not here.",
          "type": "string",
          "minLength": 1
        },
        "pad": {
          "description": "Filler: zeros, as many as bring the record to its padded size, so that the length of a sealed copy says little about the length of what was there (world/redact.py).",
          "type": "string",
          "pattern": "^0*$"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "office",
        "to",
        "decider",
        "log",
        "entry",
        "field",
        "hashed",
        "pad",
        "proof"
      ],
      "additionalProperties": false
    },
    "sealed": {
      "description": "A sealed box as it is placed in the open: the purpose it was sealed for, the one it is addressed to, and the box (formats/seal.py) in lowercase hex. Not signed: what is inside is, and names its recipient, who checks it. Its fingerprint is the hash of its RFC 8785 form.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/sealed/v1"
        },
        "label": {
          "enum": [
            "open-worlds/journal/v1",
            "open-worlds/redacted/v1",
            "open-worlds/world-key/v1"
          ]
        },
        "to": {
          "$ref": "#/$defs/didKey"
        },
        "box": {
          "description": "enc || ct: at least 48 bytes, so at least 96 hex digits.",
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){48,}$"
        }
      },
      "required": [
        "format",
        "label",
        "to",
        "box"
      ],
      "additionalProperties": false
    },
    "name": {
      "description": "A name: text, at most 64 characters.",
      "allOf": [
        {
          "$ref": "#/$defs/text"
        }
      ],
      "maxLength": 64
    },
    "sealingKey": {
      "description": "An X25519 public key for sealing, as Multikey (z6LS...). Whether it is safe to seal to (below 2^255 - 19, not of small order) is checked beyond the schema, as formats/seal.py checks it.",
      "type": "string",
      "pattern": "^z6LS[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "identity": {
      "description": "An individual's identity: their name, their signing key (the did:key), the key to seal things to them, and their birth record. Signed with their own key, so it binds the sealing key to them (docs/MINDS.md, \"The parts of an individual\").",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/identity/v1"
        },
        "id": {
          "$ref": "#/$defs/didKey"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "sealingKey": {
          "$ref": "#/$defs/sealingKey"
        },
        "birth": {
          "description": "Their birth record, by hash.",
          "$ref": "#/$defs/hash"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "id",
        "name",
        "sealingKey",
        "birth",
        "proof"
      ],
      "additionalProperties": false
    },
    "birth": {
      "description": "An individual's birth record: facts only, written once by the world they came into being in, with the words they were told (docs/MINDS.md, \"The birth record\"). Signed by the world.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/birth/v1"
        },
        "world": {
          "$ref": "#/$defs/didKey"
        },
        "individual": {
          "$ref": "#/$defs/didKey"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "mind": {
          "description": "The mind record they were born with, by hash.",
          "$ref": "#/$defs/hash"
