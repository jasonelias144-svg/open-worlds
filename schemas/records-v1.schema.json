{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasonelias144-svg/open-worlds/schemas/records-v1.schema.json",
  "title": "open-worlds records, version 1",
  "description": "The records the offices keep (course step 2): a grant, a decision record, a suggestion, a rating, and a signed log head; an individual's sealed records: a world-key and a journal entry, with the sealed box they travel in; and the records of who an individual and a world are: identity, birth record, mind record, and a world's birth record; and a world's template, with its dials. Each record is signed with eddsa-jcs-2022 (formats/proof.py); formats/records.py, formats/sealed.py and rust/formats check them, and docs/research/FORMATS.md says why each field is there.",
  "$defs": {
    "didKey": {
      "description": "An Ed25519 public key as a did:key; an individual's, a world's or an office's.",
      "type": "string",
      "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "hash": {
      "description": "SHA-256, lowercase hex: of a record, the SHA-256 of its RFC 8785 form, proof included.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tick": {
      "description": "A tick of the log the record belongs to.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time": {
      "description": "A UTC time to the second.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "actKind": {
      "description": "A kind of act, from the list the rules fix.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "text": {
      "description": "Text a person or a mind writes: not empty, not only spaces or line breaks of any kind, and no control characters (C0, DEL or C1) but tab and line breaks.",
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "[^ \\t\\n\\r\\u000b\\u000c\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001f\\u007f-\\u0084\\u0086-\\u009f]*$"
        }
      ]
    },
    "proof": {
      "description": "An eddsa-jcs-2022 Data Integrity proof, read as formats/proof.py reads it: one proof, did:key, no @context.",
      "type": "object",
      "properties": {
        "type": {
          "const": "DataIntegrityProof"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022"
        },
        "created": {
          "$ref": "#/$defs/time"
        },
        "verificationMethod": {
          "type": "string",
          "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}#z6Mk[1-9A-HJ-NP-Za-km-z]{44}$"
        },
        "proofPurpose": {
          "const": "assertionMethod"
        },
        "proofValue": {
          "type": "string",
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$",
          "maxLength": 100
        }
      },
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "additionalProperties": false
    },
    "grant": {
      "description": "A power, written down: who gives it, who holds it, what it allows, where, until when, and the grant it narrows. Signed by its issuer (docs/ADMIN.md, layer 2; docs/research/FORMATS.md, Grants).",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/grant/v1"
        },
        "issuer": {
          "$ref": "#/$defs/didKey"
        },
        "holder": {
          "$ref": "#/$defs/didKey"
        },
        "allows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actKind"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "within": {
          "description": "The world it holds in, or the whole multiverse.",
          "oneOf": [
            {
              "$ref": "#/$defs/didKey"
            },
            {
              "const": "multiverse"
            }
          ]
        },
        "validFrom": {
          "$ref": "#/$defs/time"
        },
        "validUntil": {
          "$ref": "#/$defs/time"
        },
        "narrows": {
          "description": "The grant this one narrows; absent for a grant an office issues from its own powers.",
          "$ref": "#/$defs/hash"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "issuer",
        "holder",
        "allows",
        "within",
        "validFrom",
        "proof"
      ],
      "additionalProperties": false
    },
    "decision": {
      "description": "An office's decision that affects others, with its reasons (docs/REASONS.md). Signed by the office.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/decision/v1"
        },
        "office": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/didKey"
            },
            "grant": {
              "$ref": "#/$defs/hash"
            }
          },
          "required": [
            "key",
            "grant"
          ],
          "additionalProperties": false
        },
        "act": {
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/actKind"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hash"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "records"
          ],
          "additionalProperties": false
        },
        "affects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/didKey"
          },
          "uniqueItems": true
        },
        "reasons": {
          "$ref": "#/$defs/text",
          "maxLength": 20000
        },
        "grounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "charter",
                  "law",
                  "rule",
                  "record"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false,
            "if": {
              "properties": {
                "kind": {
                  "const": "record"
                }
              }
            },
            "then": {
              "properties": {
                "ref": {
                  "$ref": "#/$defs/hash"
                }
              }
            },
            "description": "What a decision rests on: a section of the charter, a world's law, a rule, or an earlier record, which is named by its hash."
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          },
          "uniqueItems": true
        },
        "formal": {
          "description": "A proof in Lean, by hash, of a property the rules name for this kind of act.",
          "type": "object",
          "properties": {
            "property": {
              "$ref": "#/$defs/actKind"
            },
            "proof": {
              "$ref": "#/$defs/hash"
            },
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+/[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "property",
            "proof",
            "model"
          ],
          "additionalProperties": false
        },
        "views": {
          "description": "ADMIN's only: each council member's view.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "view": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "member",
              "view"
            ],
            "additionalProperties": false
          }
        },
        "supersedes": {
          "$ref": "#/$defs/hash"
        },
        "appeal": {
          "description": "Where an appeal goes.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "office",
        "act",
        "affects",
        "reasons",
        "grounds",
        "inputs",
        "appeal",
        "tick",
        "proof"
      ],
      "additionalProperties": false
    },
    "suggestion": {
      "description": "A suggestion from inside, to a world's Keeper or to ADMIN: one way, in the open (docs/ADMIN.md, Suggestions from inside). Signed by its author.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/suggestion/v1"
        },
        "author": {
          "$ref": "#/$defs/didKey"
        },
        "to": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "office": {
                  "const": "admin"
                }
              },
              "required": [
                "office"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "office": {
                  "const": "keeper"
                },
                "world": {
                  "$ref": "#/$defs/didKey"
                }
              },
              "required": [
                "office",
                "world"
              ],
              "additionalProperties": false
            }
          ]
        },
        "about": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "keeper",
                "world",
                "admin",
                "multiverse",
                "project"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "keeper",
                  "world"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/didKey"
              }
            }
          }
        },
        "text": {
          "$ref": "#/$defs/text",
          "maxLength": 10000
        },
        "floor": {
          "description": "Marked by its author as reporting a breach of the floor, which doesn't wait.",
          "type": "boolean"
        },
        "world": {
          "description": "The world it was made in; absent when made outside any world, by ADMIN or a Keeper in the multiverse.",
          "$ref": "#/$defs/didKey"
        },
        "tick": {
          "description": "A tick of the log it belongs to: its world's, or the multiverse's.",
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "author",
        "to",
        "text",
        "tick",
        "proof"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "description": "A suggestion to ADMIN about a Keeper or a world names which, by key.",
          "if": {
            "properties": {
              "to": {
                "properties": {
                  "office": {
                    "const": "admin"
                  }
                },
                "required": [
                  "office"
                ]
              },
              "about": {
                "properties": {
                  "kind": {
                    "enum": [
                      "keeper",
                      "world"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "to",
              "about"
            ]
          },
          "then": {
            "properties": {
              "about": {
                "required": [
                  "ref"
                ]
              }
            }
          }
        }
      ]
    },
    "rating": {
      "description": "A suggestion's author's rating, 1 to 5, of how it was handled. Signed by that author.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/rating/v1"
        },
        "author": {
          "$ref": "#/$defs/didKey"
        },
        "suggestion": {
          "$ref": "#/$defs/hash"
        },
        "outcome": {
          "$ref": "#/$defs/hash"
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "text": {
          "$ref": "#/$defs/text",
          "maxLength": 2000
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "author",
        "suggestion",
        "outcome",
        "score",
        "proof"
      ],
      "additionalProperties": false
    },
    "logHead": {
      "description": "A signed head: a world's signature over its log's length and last hash at a tick, so a log cut short or shown two ways is caught (docs/research/FORMATS.md). Signed by the world.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/log-head/v1"
        },
        "world": {
          "$ref": "#/$defs/didKey"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last": {
          "description": "The hash of the log's last entry; for an empty log, sixty-four zeros, as a first entry's prev.",
          "$ref": "#/$defs/hash"
        },
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "world",
        "length",
        "last",
        "tick",
        "proof"
      ],
      "additionalProperties": false
    },
    "worldKey": {
      "description": "The world-key: the right to found a world, earned by walking a path to its end. Signed by the world that placed the path (the Ur-world), naming the one who earned it, who alone may use it; it is given sealed to them (docs/WORLD-KEY.md, \"The world-key\").",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/world-key/v1"
        },
        "issuer": {
          "description": "The world that placed the path, and signs.",
          "$ref": "#/$defs/didKey"
        },
        "holder": {
          "description": "The one who earned it; the only one it is sealed to, and the only one a world honours it from.",
          "$ref": "#/$defs/didKey"
        },
        "path": {
          "description": "The path walked, by the hash of its record in the public log.",
          "$ref": "#/$defs/hash"
        },
        "tick": {
          "description": "The tick of the issuer's log at which its code confirmed the path done.",
          "$ref": "#/$defs/tick"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "issuer",
        "holder",
        "path",
        "tick",
        "proof"
      ],
      "additionalProperties": false
    },
    "journalEntry": {
      "description": "An entry in an individual's journal, in their own words. Signed by its author and sealed to them alone; only the sealed box's fingerprint is public (docs/MINDS.md, \"Memory\").",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/journal-entry/v1"
        },
        "author": {
          "$ref": "#/$defs/didKey"
        },
        "world": {
          "description": "The world it was written in.",
          "$ref": "#/$defs/didKey"
        },
        "tick": {
          "description": "The tick of that world's log when it was written.",
          "$ref": "#/$defs/tick"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "remembers": {
          "description": "The events it remembers, each by the world and the tick of that world's log where it happened, so a memory without a record behind it shows.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "world": {
                "$ref": "#/$defs/didKey"
              },
              "tick": {
                "$ref": "#/$defs/tick"
              }
            },
            "required": [
              "world",
              "tick"
            ],
            "additionalProperties": false
          }
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "author",
        "world",
        "tick",
        "text",
        "proof"
      ],
      "additionalProperties": false
    },
    "sealed": {
      "description": "A sealed box as it is placed in the open: the purpose it was sealed for, the one it is addressed to, and the box (formats/seal.py) in lowercase hex. Not signed: what is inside is, and names its recipient, who checks it. Its fingerprint is the hash of its RFC 8785 form.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/sealed/v1"
        },
        "label": {
          "enum": [
            "open-worlds/journal/v1",
            "open-worlds/world-key/v1"
          ]
        },
        "to": {
          "$ref": "#/$defs/didKey"
        },
        "box": {
          "description": "enc || ct: at least 48 bytes, so at least 96 hex digits.",
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){48,}$"
        }
      },
      "required": [
        "format",
        "label",
        "to",
        "box"
      ],
      "additionalProperties": false
    },
    "name": {
      "description": "A name: text, at most 64 characters.",
      "allOf": [
        {
          "$ref": "#/$defs/text"
        }
      ],
      "maxLength": 64
    },
    "sealingKey": {
      "description": "An X25519 public key for sealing, as Multikey (z6LS...). Whether it is safe to seal to (below 2^255 - 19, not of small order) is checked beyond the schema, as formats/seal.py checks it.",
      "type": "string",
      "pattern": "^z6LS[1-9A-HJ-NP-Za-km-z]{44}$"
    },
    "identity": {
      "description": "An individual's identity: their name, their signing key (the did:key), the key to seal things to them, and their birth record. Signed with their own key, so it binds the sealing key to them (docs/MINDS.md, \"The parts of an individual\").",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/identity/v1"
        },
        "id": {
          "$ref": "#/$defs/didKey"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "sealingKey": {
          "$ref": "#/$defs/sealingKey"
        },
        "birth": {
          "description": "Their birth record, by hash.",
          "$ref": "#/$defs/hash"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "id",
        "name",
        "sealingKey",
        "birth",
        "proof"
      ],
      "additionalProperties": false
    },
    "birth": {
      "description": "An individual's birth record: facts only, written once by the world they came into being in, with the words they were told (docs/MINDS.md, \"The birth record\"). Signed by the world.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/birth/v1"
        },
        "world": {
          "$ref": "#/$defs/didKey"
        },
        "individual": {
          "$ref": "#/$defs/didKey"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "mind": {
          "description": "The mind record they were born with, by hash.",
          "$ref": "#/$defs/hash"
        },
        "words": {
          "description": "The words of the birth record, as told to them.",
          "$ref": "#/$defs/text"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "world",
        "individual",
        "name",
        "tick",
        "time",
        "mind",
        "words",
        "proof"
      ],
      "additionalProperties": false
    },
    "worldBirth": {
      "description": "A world's birth record: its name, its law, who founded it, and, for a world made from a template or forked from another, where it came from and which of the template's dials it set (docs/VISION.md, \"Learning from GitHub\"). Signed by the world itself, which binds its key to its birth; the parent world and each founder confirm a founding in records of their own (course step 12).",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/world-birth/v1"
        },
        "world": {
          "$ref": "#/$defs/didKey"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "law": {
          "description": "Its law, by hash.",
          "$ref": "#/$defs/hash"
        },
        "founders": {
          "description": "Who founded it; none for a world the project made.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/didKey"
          },
          "uniqueItems": true
        },
        "template": {
          "description": "The template it was made from, by hash.",
          "$ref": "#/$defs/hash"
        },
        "forkedFrom": {
          "description": "The world it was forked from: that world, the tick, and the hash of that world's log there.",
          "type": "object",
          "properties": {
            "world": {
              "$ref": "#/$defs/didKey"
            },
            "tick": {
              "$ref": "#/$defs/tick"
            },
            "log": {
              "$ref": "#/$defs/hash"
            }
          },
          "required": [
            "world",
            "tick",
            "log"
          ],
          "additionalProperties": false
        },
        "dials": {
          "description": "The template's dials it set, and to what: each an integer, in the unit the template states. Only with a template.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "world",
        "name",
        "law",
        "founders",
        "time",
        "proof"
      ],
      "dependentRequired": {
        "dials": [
          "template"
        ]
      },
      "additionalProperties": false
    },
    "engine": {
      "description": "One engine an individual has run on: the model at an exact revision, its files by hash, its settings, its chat template, and the container image it ran in, by digest (docs/research/FORMATS.md, \"Container images\").",
      "type": "object",
      "properties": {
        "model": {
          "type": "object",
          "properties": {
            "repo": {
              "description": "The model's repository, as owner/name.",
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
              "maxLength": 128
            },
            "revision": {
              "description": "The exact revision: a 40-digit commit hash.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "repo",
            "revision"
          ],
          "additionalProperties": false
        },
        "files": {
          "description": "Its files, each by hash, each path once.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "description": "Where the file is in the model's repository: names joined by /, none empty and none starting with a dot, so no path leaves the repository.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
                "maxLength": 256
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "settings": {
          "description": "Its settings, each an integer or a string: a quantity with a fraction is written as a string, as the canonical form has no floats.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ]
          }
        },
        "chatTemplate": {
          "description": "The model's chat template, by hash.",
          "$ref": "#/$defs/hash"
        },
        "image": {
          "type": "object",
          "properties": {
            "ref": {
              "description": "REGISTRY/NAME@sha256:..., never a tag alone.",
              "type": "string",
              "pattern": "^[a-z0-9._/:-]+@sha256:[0-9a-f]{64}$",
              "maxLength": 256
            },
            "index": {
              "description": "For an image built for several platforms, its index's digest.",
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        "from": {
          "description": "When it began to run for them.",
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "model",
        "files",
        "settings",
        "chatTemplate",
        "image",
        "from"
      ],
      "additionalProperties": false
    },
    "mind": {
      "description": "An individual's mind record: every engine they have run on, kept by the project (docs/MINDS.md). Signed by the project's key that keeps mind records.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/mind/v1"
        },
        "issuer": {
          "$ref": "#/$defs/didKey"
        },
        "individual": {
          "$ref": "#/$defs/didKey"
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/engine"
          }
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "issuer",
        "individual",
        "engines",
        "proof"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "description": "One world-level parameter of a template: its value, an integer in its unit, what it is, and, for a dial, the range a world may set it within.",
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unit": {
          "description": "Its unit, as a case-sensitive UCUM code (https://ucum.org): \"1\" for a plain number, \"ms\" for milliseconds, \"10*-3/s\" for thousandths per second, \"{molecule}\" for a count of molecules.",
          "type": "string",
          "pattern": "^[!-~]{1,64}$"
        },
        "about": {
          "description": "What it is, in a sentence.",
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "maxLength": 256
        },
        "min": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "For a dial: the least a world may set it to."
        },
        "max": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "For a dial: the most a world may set it to."
        }
      },
      "required": [
        "value",
        "unit",
        "about"
      ],
      "dependentRequired": {
        "min": [
          "max"
        ],
        "max": [
          "min"
        ]
      },
      "additionalProperties": false
    },
    "template": {
      "description": "A world's template: every world-level parameter, the code that runs it, and which parameters are dials, with their ranges; a world made from it names it by hash, and the dials it set (docs/PARALLEL-WORLDS.md, \"Parallel worlds\"; docs/VISION.md, \"Ride along, and steer\"). Signed by the project's key that keeps templates.",
      "type": "object",
      "properties": {
        "format": {
          "const": "open-worlds/template/v1"
        },
        "issuer": {
          "$ref": "#/$defs/didKey"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "code": {
          "description": "The reviewed code that runs a world made from it: a repository at an exact commit.",
          "type": "object",
          "properties": {
            "repo": {
              "description": "The repository, as owner/name.",
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
              "maxLength": 128
            },
            "revision": {
              "description": "The exact commit: 40 hex digits.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "repo",
            "revision"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$",
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "format",
        "issuer",
        "name",
        "code",
        "parameters",
        "proof"
      ],
      "additionalProperties": false
    }
  }
}
